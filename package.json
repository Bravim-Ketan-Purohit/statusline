{
  "name": "statusline-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm bench",
    "bench": "node packages/cli/dist/bench.js",
    "verify": "pnpm build && pnpm test",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/build-site.mjs && npx --yes serve dist-site -l 5000",
    "media:publish": "bash scripts/publish-media.sh",
    "media:check": "node scripts/check-media.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "1.49.0",
    "typescript": "^5.6.3"
  }
}
